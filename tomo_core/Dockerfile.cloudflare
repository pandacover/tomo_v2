FROM python:3.11.11-slim-bookworm

COPY --from=docker.io/cloudflare/sandbox:0.12.7 /container-server/sandbox /sandbox

# The sandbox container server runs commands with cwd=/workspace; without this
# directory every spawn fails with a misleading ENOENT on the shell binary.
RUN mkdir -p /workspace

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/tomo/.venv/bin:$PATH"

WORKDIR /opt/tomo

COPY pyproject.toml uv.lock ./
COPY src ./src
COPY SOUL.md ./SOUL.md

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir "uv==0.6.14" \
    && uv sync --frozen --no-dev \
    && tomo-core --help

EXPOSE 8080
ENTRYPOINT ["/sandbox"]
