FROM python:3.11.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/tomo/.venv/bin:$PATH"

WORKDIR /opt/tomo

COPY pyproject.toml uv.lock ./
COPY src ./src
COPY SOUL.md ./SOUL.md

RUN pip install --no-cache-dir "uv==0.6.14" \
    && uv sync --frozen --no-dev \
    && tomo-core --help
